NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only emergency owner password. Set per client and never share with the merchant.
ADMIN_PASSWORD=change-this-password
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Formal employee accounts use Supabase Auth + public.admin_users.
# Keep ADMIN_PASSWORD as an owner emergency fallback.
# Store Settings and Legal Settings use the separate developer credential seeded
# as a salted hash in public.developer_access; no plaintext developer password is configured here.
# These optional role passwords are only fallback/testing shortcuts.
ADMIN_STAFF_PASSWORD=
ADMIN_INVENTORY_PASSWORD=
ADMIN_READONLY_PASSWORD=

# POS checkout/void RPC transaction path. Keep false until production validation is complete.
USE_POS_RPC=false

# Translation and AI assistant - DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_TRANSLATION_MODEL=deepseek-chat

# Optional: AI styling image generation for admin product photos
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Basic legal pages template fields.
# Fill these before launching a client project. Only enabled providers should be listed.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_VAT_NUMBER=
NEXT_PUBLIC_LEGAL_GEMI_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_COUNTRY=Greece
NEXT_PUBLIC_LEGAL_DATA_CONTROLLER_NAME=
NEXT_PUBLIC_LEGAL_DATA_CONTROLLER_ADDRESS=
NEXT_PUBLIC_LEGAL_DATA_PROCESSORS=Supabase,Vercel
NEXT_PUBLIC_LEGAL_PAYMENT_PROVIDERS=
NEXT_PUBLIC_LEGAL_ANALYTICS_PROVIDERS=
NEXT_PUBLIC_LEGAL_AI_PROVIDERS=
NEXT_PUBLIC_LEGAL_DATA_RETENTION=
NEXT_PUBLIC_LEGAL_LAST_UPDATED=
