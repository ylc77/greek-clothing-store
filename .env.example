NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

ADMIN_PASSWORD=change-this-password
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# POS checkout/void RPC transaction path. Keep false until production validation is complete.
USE_POS_RPC=false

# Translation and AI assistant - DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_TRANSLATION_MODEL=deepseek-chat

# Optional: AI styling image generation for admin product photos
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
